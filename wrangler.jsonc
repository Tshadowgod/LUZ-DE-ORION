{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luz-de-orion",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  // nodejs_compat: lo necesitan el driver de Neon y el adaptador de Next.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // El bucket queda conectado directo al worker: no hacen falta claves de API
  // ni secretos. Si le pusiste otro nombre al bucket, cambialo aca.
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "luz-de-orion"
    }
  ],
  "observability": {
    "enabled": true
  }
}
