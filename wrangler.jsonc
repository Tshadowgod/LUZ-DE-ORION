{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luz-de-orion",
  "main": ".open-next/worker.js",
  // Temporal: la cuenta todavia no registro su subdominio workers.dev y sin
  // eso el deploy falla. Con esto el worker se publica igual, solo que sin
  // URL publica. Cambiar a true (o borrar la linea) cuando el subdominio
  // exista, o conectar el dominio propio con una ruta.
  "workers_dev": false,
  "compatibility_date": "2026-09-20",
  // nodejs_compat: lo necesitan el driver de Neon y el adaptador de Next.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Las fotos van en Workers KV, que entra en el plan gratis y no pide
  // tarjeta. R2 seria lo ideal para archivos, pero exige medio de pago.
  // Para el tamano de esta tienda (148 fotos, ~33 MB) KV sobra: el limite
  // gratis es 1 GB.
  "kv_namespaces": [
    {
      "binding": "FOTOS",
      "id": "637a6848a0e84a5daa36c9019c3d6f7a"
    }
  ],
  "observability": {
    "enabled": true
  }
}
